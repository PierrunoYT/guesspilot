{
  "manifest_version": 3,
  "name": "GuessPilot",
  "version": "1.0.0",
  "description": "Screenshots a GeoGuessr / WorldGuessr round and asks Gemini 4 Argon (via OpenRouter) where it is.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://openrouter.ai/*",
    "*://*.geoguessr.com/*",
    "*://*.worldguessr.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.geoguessr.com/*", "*://*.worldguessr.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["prompt.js", "background.js"]
  },
  "action": {
    "default_title": "GuessPilot",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "analyze": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Analyze the current round"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "guesspilot@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  }
}
